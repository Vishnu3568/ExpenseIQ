# Server Execution Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Database Connection URI (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseiq?schema=public"

# Frontend Origin URL (CORS authorization target)
CLIENT_URL="http://localhost:5173"

# JWT Token Secrets (Minimum 32 random characters in production)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_characters"
